{
  "name": "aks-mentorluk",
  "productName": "AKS Mentorluk",
  "version": "1.0.0",
  "description": "AKS Mentorluk - Oda, Ogrenci ve Otomasyon Yonetim Sistemi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "AKS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6"
  },
  "build": {
    "appId": "com.aks.mentorluk",
    "productName": "AKS Mentorluk",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/whatsapp-web.js/**",
      "node_modules/puppeteer/**",
      "node_modules/puppeteer-core/**",
      "node_modules/puppeteer-extra/**",
      "node_modules/@puppeteer/**",
      "node_modules/qrcode/**"
    ],
    "files": [
      "**/*",
      "!.cache/**",
      "!dist/**",
      "!dist*/**",
      "!dist-guncel/**",
      "!node_modules/electron/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/electron-builder/**",
      "!shot*.png",
      "!VERIYEDEGI/**",
      "!_*.html"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AKS Mentorluk"
    }
  },
  "allowScripts": {
    "electron@32.0.0": true
  }
}
